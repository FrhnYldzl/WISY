# Wisy ortam değişkenleri. Yerelde wisy/.env (git dışı), dağıtımda Railway → Wisy servisi → Variables.
# Wisy bağımsız bir üründür: kendi deposu, kendi Railway projesi, kendi anahtarı. Başka projeyle değişken paylaşmaz.

# Claude (Wisy Stüdyo). Yalnız bu ad okunur; genel ANTHROPIC_API_KEY bilerek yok sayılır.
WISY_ANTHROPIC_API_KEY=sk-ant-...

# Giriş (dağıtımda zorunlu; yerelde boş bırakılırsa giriş kapalı)
# Özet üret: npm run sifre -- "<parola>"     Gizli anahtar: openssl rand -base64 32
# WISY_PASSWORD_HASH=scrypt:...
# WISY_SESSION_SECRET=
# WISY_SESSION_DAYS=14

# Kasa ve uygulama durumu. Railway'de Volume'ü /data'ya bağla:
#   WISY_VAULT=/data/vault      (ilk açılışta depodaki vault/ tohum olarak kopyalanır)
#   WISY_DATA=/data/wisy.db
# Yerelde varsayılanlar: wisy/vault ve wisy/var/wisy.db. Obsidian Master içindeki kasayı göstermek için:
# WISY_VAULT=C:/Users/.../Obsidian/Master/BILGE/Wisy

# Aylık Claude bütçesi (USD). Dolunca ajanlar durur.
# WISY_AYLIK_TAVAN_USD=30

# Yerel port ve adres (Railway PORT verir ve 0.0.0.0 kullanılır)
# WISY_PORT=8788
# WISY_HOST=127.0.0.1
